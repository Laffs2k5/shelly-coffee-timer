# Copy this file to .env and fill in your real values.
#
#   cp .env.example .env
#
# Then load it before running any script:
#
#   source .env
#
# IMPORTANT: .env is gitignored — never rename it to something
# that is NOT covered by the .gitignore patterns (*.env, secrets.*).
# This repo is PUBLIC. Do not commit real credentials anywhere.

# Shelly device IP on your LAN — HTTP-direct control + RPC. Used by scripts/test-local-api.sh.
SHELLY_IP="192.168.1.xxx"

# Local MQTT broker (Mosquitto on the LAN, mTLS). The device + on-Wi-Fi clients use this.
MQTT_LOCAL_HOST="192.168.x.x"

# Cloud MQTT (EMQX Serverless) — off-LAN access via the bridge. Username/password only.
MQTT_CLOUD_HOST="your-deployment.emqxsl.com"
MQTT_CLOUD_USER="your_cloud_mqtt_user"
MQTT_CLOUD_PASS="your_cloud_mqtt_password"

# Note: the client mTLS identity is a .p12 imported on-device (never in .env / the repo);
# the broker's public CA cert goes in app/src/main/res/raw/mqtt_ca.crt at build time.
